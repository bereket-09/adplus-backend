{
  "name": "video-ads-backend",
  "version": "1.0.0",
  "description": "MVP backend for short video ads - JSON API only",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:api": "WORKERS_ENABLED=false node server.js",
    "start:worker": "WORKERS_ENABLED=true node server.js",
    "check": "for f in $(find src server.js -name '*.js'); do node --check \"$f\" || exit 1; done && echo 'syntax ok'"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.27.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.0.2",
    "mysql": "^2.18.1",
    "uuid": "^8.3.2",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
