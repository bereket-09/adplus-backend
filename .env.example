# ===========================================================================
# AdPlus backend — environment template. Copy to .env and fill in.
# ===========================================================================

NODE_ENV=production
PORT=3001

# ---- Datastores ----
MONGO_URI=mongodb://localhost:27017/video_ads
# Redis is REQUIRED in production: it holds the authoritative budget counters,
# pacing buckets, frequency/seen-sets, and the trigger queue. Without it the
# engine falls back to in-memory state that is per-process and unsafe when scaled.
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=adplus:

# ---- Auth ----
JWT_SECRET=replace_this_with_real_secret
TOKEN_SECRET=your_token_secret_for_watch_tokens
TOKEN_EXPIRY_HOURS=3
ADMIN_API_KEY=your_admin_api_key

# ---- Public URLs ----
API_DOMAIN=https://adplus.example.et
# Base used to build the SMS watch link (points at the Next.js /watch page).
WATCH_BASE_URL=https://adplus.example.et

# ---- Workers ----
# true  = this process serves API AND drains the trigger queue (small setups)
# false = API only; run a separate `npm run start:worker` fleet
WORKERS_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=20

# ---- OCS trigger ingestion ----
# Shared secret the OCS sends as header `x-ocs-key`. Leave blank to disable (dev).
OCS_TRIGGER_KEY=
QUEUE_DRIVER=auto           # auto | redis | memory
QUEUE_MAX_LEN=2000000

# ---- SMS gateway (HTTP) ----
SMS_DRIVER=http             # http | mock  (auto-mock if SMS_HTTP_URL unset)
SMS_HTTP_URL=https://sms.ethiotelecom.et/api/send
SMS_API_KEY=your_sms_provider_key
SMS_SENDER_ID=ADREWARD
SMS_TIMEOUT_MS=5000
SMS_TEMPLATE=Watch a short ad & get {reward}. Tap: {url} (valid {validity}h)

# ---- Reward fulfilment (synchronous HTTP to ETC) ----
REWARD_DRIVER=http          # http | mock
REWARD_HTTP_URL=https://provisioning.ethiotelecom.et/api/grant
REWARD_API_KEY=your_reward_api_key
REWARD_TIMEOUT_MS=8000

# ---- Storage (video/banner/KYC) ----
SUPABASE_URL=
SUPABASE_KEY=

# ===========================================================================
# ENGINE TUNING (safe defaults shown; override per deployment)
# ===========================================================================

# Budget
DEFAULT_CPV=1               # ETB per view if an ad has none set
CLICK_COST_RATIO=0.5        # click fee as fraction of CPV
RESERVATION_TTL_MINUTES=180 # how long a reservation is held before sweeper reclaims

# Watch link
WATCH_VALIDITY_MINUTES=180  # subscriber has 3h to watch
WATCH_PURGE_DAYS=7          # Mongo deletes the row after this

# Frequency caps (per subscriber)
FREQ_MAX_SMS_DAY=3
FREQ_MAX_SMS_WEEK=12
FREQ_MAX_VIEWS_DAY=3
FREQ_MIN_GAP_MINUTES=90     # minimum spacing between two SMS
SEEN_WINDOW_DAYS=14         # an ad stays "seen" (no repeats) for this long

# Eligibility scoring ("smart" suppression)
ELIGIBILITY_MIN_SCORE=0.35
W_UNSEEN=0.35
W_FREQ=0.25
W_RECENCY=0.20
W_ENGAGEMENT=0.20
ENGAGEMENT_MIN_SAMPLES=4

# Pacing
PACING_ENABLED=true
SMS_GATEWAY_MAX_PER_SEC=50  # hard ceiling protecting the SMS gateway
SMS_GATEWAY_BURST=100
SPEND_WINDOW_HOURS=6        # spread each campaign's daily budget across this window
CANDIDATE_STALE_MINUTES=45  # drop queued triggers older than this

LOG_LEVEL=info
